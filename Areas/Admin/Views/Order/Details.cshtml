@model Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Chi tiết Đơn hàng #@Model.Id</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-white fw-bold">Gói chụp đã đặt</div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@(detail.Product?.Name ?? "Sản phẩm không xác định")</td>
                                    <td>@detail.Price.ToString("N0") VNĐ</td>
                                    <td>@detail.Quantity</td>
                                    <td class="fw-bold">@((detail.Price * detail.Quantity).ToString("N0")) VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-white fw-bold">Trạng thái & Thanh toán</div>
                <div class="card-body">
                    <h5 class="text-danger fw-bold mb-3">Tổng cộng: @Model.TotalPrice.ToString("N0") VNĐ</h5>

                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Cập nhật trạng thái</label>
                            <select name="status" class="form-select">
                                <option value="Chờ xác nhận" selected="@(Model.Status == "Chờ xác nhận")">Chờ xác nhận</option>
                                <option value="Đã xác nhận" selected="@(Model.Status == "Đã xác nhận")">Đã xác nhận</option>
                                <option value="Đã hoàn thành" selected="@(Model.Status == "Đã hoàn thành")">Đã hoàn thành</option>
                                <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Lưu trạng thái</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>