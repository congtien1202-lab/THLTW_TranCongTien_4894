@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Bảng điều khiển Admin";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase">Chào mừng quay trở lại, Admin</h1>
        <p class="text-muted">Vui lòng chọn chức năng bạn muốn quản lý bên dưới</p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <div class="card shadow border-0 h-100 text-center p-4 card-hover">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi bi-box-seam text-primary" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="card-title fw-bold">QUẢN LÝ SẢN PHẨM</h3>
                    <p class="card-text text-muted mb-4">Thêm, sửa, xóa và cập nhật kho ảnh sản phẩm của tiệm.</p>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                       class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">Truy cập ngay</a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow border-0 h-100 text-center p-4 card-hover">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi bi-cart-check text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="card-title fw-bold">QUẢN LÝ ĐƠN HÀNG</h3>
                    <p class="card-text text-muted mb-4">Theo dõi trạng thái đơn hàng, xác nhận và xử lý thanh toán.</p>
                    <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                       class="btn btn-success btn-lg rounded-pill px-5 shadow-sm">Xem đơn hàng</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

        .card-hover:hover {
            transform: translateY(-10px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }
</style>