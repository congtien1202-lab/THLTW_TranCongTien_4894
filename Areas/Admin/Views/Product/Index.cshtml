@model IEnumerable<SellingWebsite.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 1px;">Quản lý kho hàng</h2>
        <a asp-action="Add" class="btn btn-dark fw-bold rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg"></i> + THÊM SẢN PHẨM
        </a>
    </div>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 100px;">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Danh mục</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <img src="@item.ImageUrl" alt="@item.Name" class="rounded shadow-sm"
                                             style="width: 60px; height: 60px; object-fit: cover;"
                                             onerror="this.src='/images/no-image.png'" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        <small class="text-muted">ID: @item.Id</small>
                                    </td>
                                    <td>
                                        <span class="text-danger fw-bold">@item.Price.ToString("#,##0") VNĐ</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Category?.Name</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill me-1">
                                            Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3 rounded-pill">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <p class="mb-0">Chưa có sản phẩm nào trong kho hàng.</p>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>