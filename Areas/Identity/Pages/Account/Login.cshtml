@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-white text-center py-4 border-0">
                    <h2 class="font-weight-light fw-bold" style="color: #2c3e50;">TIỆM ẢNH TÁCH TÁCH</h2>
                    <p class="text-muted mb-0">Đăng nhập để tiếp tục</p>
                </div>

                <div class="card-body px-5 py-4">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label text-muted">Địa chỉ Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger text-sm"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label text-muted">Mật khẩu</label>
                            <span asp-validation-for="Input.Password" class="text-danger text-sm"></span>
                        </div>

                        <div class="form-check mb-4">
                            <label asp-for="Input.RememberMe" class="form-check-label text-muted">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                Ghi nhớ tài khoản
                            </label>
                        </div>

                        <div class="d-grid gap-2 mt-4 mb-2">
                            <button id="login-submit" type="submit" class="btn btn-dark btn-lg fw-bold rounded-pill">ĐĂNG NHẬP</button>
                        </div>
                    </form>
                </div>

                <div class="card-footer text-center py-4 bg-light border-0 rounded-bottom">
                    <div class="small">
                        <span class="text-muted">Chưa có tài khoản? </span>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-dark">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}