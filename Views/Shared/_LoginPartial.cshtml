@using Microsoft.AspNetCore.Identity
@using SellingWebsite.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // Chuẩn bị sẵn dữ liệu ngay từ đầu để HTML bên dưới gọn gàng hơn
    string displayName = "Người dùng";
    string avatarUrl = "/images/default-avatar.png";

    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            // 1. Xử lý hiển thị Tên đầy đủ
            displayName = $"{currentUser.FirstName} {currentUser.LastName}".Trim();
            if (string.IsNullOrEmpty(displayName))
            {
                displayName = currentUser.Email ?? "Người dùng";
            }

            // 2. Xử lý đường dẫn Avatar
            if (!string.IsNullOrEmpty(currentUser.AvatarUrl))
            {
                avatarUrl = currentUser.AvatarUrl;
            }
        }
    }
}

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center py-0" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">

                <img src="@avatarUrl" class="rounded-circle border shadow-sm"
                     style="width: 38px; height: 38px; object-fit: cover; border: 2px solid #fff;"
                     onerror="this.src='/images/default-avatar.png'">

                <span class="ms-2 d-none d-lg-inline text-dark fw-bold">
                    @displayName
                </span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                <li>
                    <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-person-circle me-2"></i> Hồ sơ của tôi
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item text-danger py-2">
                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-bold" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn btn-dark text-white px-4 ms-2 rounded-pill shadow-sm" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </li>
    }
</ul>