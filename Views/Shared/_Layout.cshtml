@using Microsoft.AspNetCore.Identity
@using SellingWebsite.Models
@using SellingWebsite.Extensions
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="~/Images/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/Images/favicon.png" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <title>@ViewData["Title"] - Tiệm ảnh Tách Tách</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f9fa;
        }

        .navbar {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
        }

        .nav-link {
            transition: color 0.3s ease;
        }

            .nav-link:hover {
                color: #000 !important;
            }

        footer {
            background-color: #fff;
            border-top: 1px solid #eee;
        }

        .main-content {
            min-height: 80vh;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold" asp-area="" asp-controller="Product" asp-action="Index">
                    <img src="~/Images/logo.png" class="rounded-circle shadow-sm me-2" style="width: 45px; height: 45px;" alt="Logo" />
                    <span style="letter-spacing: 2px;">TIỆM ẢNH TÁCH TÁCH</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold text-uppercase small" asp-area="" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item me-3">
                            <a class="nav-link text-dark position-relative"asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-bag-heart fs-5"></i> @{
                                                                var cart = Context.Session.GetJson<List<int>>("Cart");
                                var count = cart?.Count ?? 0;
                                                                }
                                @if (count > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7rem;">
                                        @count
                                    </span>
                                }
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted py-5 mt-5">
        <div class="container text-center">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="text-dark fw-bold">TIỆM ẢNH TÁCH TÁCH</h5>
                    <p class="small">Nơi lưu giữ những khoảnh khắc đẹp nhất qua ống kính chuyên nghiệp.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-dark fw-bold">LIÊN HỆ</h5>
                    <p class="small mb-1">Địa chỉ: Đông Hòa, Dĩ An, Bình Dương</p>
                    <p class="small">Email: congtien@tachtach.vn</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-dark fw-bold">CHÍNH SÁCH</h5>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-muted text-decoration-none">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4">
            <p class="mb-0">&copy; @DateTime.Now.Year - Tiệm ảnh Tách Tách - Lưu giữ kỷ niệm của bạn</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<style>
    /* Hiệu ứng cho ảnh đại diện trên Navbar */
    .nav-link img.rounded-circle {
        transition: all 0.3s ease-in-out; /* Tạo chuyển động mượt mà */
        border: 2px solid transparent; /* Viền mặc định ẩn */
    }

        .nav-link img.rounded-circle:hover {
            transform: scale(1.1); /* Phóng to 10% */
            border-color: #007bff !important; /* Đổi màu viền sang xanh */
            box-shadow: 0 4px 8px rgba(0,0,0,0.2); /* Thêm đổ bóng */
            cursor: pointer;
        }
</style>