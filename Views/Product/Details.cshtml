@model SellingWebsite.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-dark fw-bold">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row bg-white p-4 rounded shadow-sm">
        <div class="col-md-6 mb-4 mb-md-0 text-center">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)"
                 class="img-fluid rounded"
                 alt="@Model.Name"
                 style="max-height: 500px; object-fit: cover;">
        </div>

        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="fw-bold mb-2">@Model.Name</h1>

            <div class="mb-3">
                <span class="badge bg-light text-dark border px-3 py-2">
                    <i class="bi bi-tag-fill text-secondary"></i> @(Model.Category?.Name ?? "Chưa phân loại")
                </span>
            </div>

            <h2 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") VNĐ</h2>

            <div class="mb-4">
                <h5 class="fw-bold">Mô tả gói chụp:</h5>
                <p class="text-muted" style="white-space: pre-line; line-height: 1.8;">@Model.Description</p>
            </div>

            <div class="mt-auto">
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-dark btn-lg rounded-pill px-5 shadow">
                        <i class="bi bi-bag-plus fs-5 me-2"></i> Đặt lịch ngay
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>