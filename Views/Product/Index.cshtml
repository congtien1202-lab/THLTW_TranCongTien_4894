@model IEnumerable<SellingWebsite.Models.Product>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold">Sản phẩm nổi bật</h2>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover position-relative">
                    <div style="height: 250px; overflow: hidden;">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                             class="card-img-top w-100 h-100"
                             style="object-fit: cover;"
                             alt="@item.Name">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark stretched-link">
                            <h5 class="card-title fw-bold">@item.Name</h5>
                        </a>

                        <p class="text-danger fw-bold mb-1">@item.Price.ToString("N0") VNĐ</p>
                        <p class="text-muted small mb-2">@item.Description</p>

                        <div class="mb-3">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-tag"></i> @(item.Category?.Name ?? "Chưa phân loại")
                            </span>
                        </div>

                        <div class="mt-auto d-flex justify-content-end align-items-center position-relative" style="z-index: 2;">
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="m-0">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3">
                                    <i class="bi bi-bag-plus"></i> Đặt lịch
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
    }
</style>