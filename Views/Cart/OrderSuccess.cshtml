@model int
@{
    ViewData["Title"] = "Đặt lịch thành công";
}

<div class="container mt-5 text-center">
    <div class="card shadow border-0 p-5">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h2 class="fw-bold">ĐẶT LỊCH THÀNH CÔNG!</h2>
        <p class="text-muted">Mã đơn hàng của bạn là: <strong>#@Model</strong></p>
        <p>Cảm ơn bạn đã tin tưởng Tiệm ảnh Tách Tách. Chúng mình sẽ liên hệ sớm nhất để xác nhận lịch chụp.</p>

        <div class="mt-4">
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark me-2">Tiếp tục xem ảnh</a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-dark">Kiểm tra lịch sử</a>
        </div>
    </div>
</div>