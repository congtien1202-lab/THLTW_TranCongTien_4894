@model SellingWebsite.Models.Category

<h2>@(Model == null || Model.Id == 0 ? "Thêm mới" : "Cập nhật") Danh mục</h2>

<form asp-action="@(Model == null || Model.Id == 0 ? "Add" : "Update")" method="post">
    <div class="form-group">
        <label asp-for="Name">Tên danh mục</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @if (Model != null && Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <button type="submit" class="btn btn-success mt-2">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}